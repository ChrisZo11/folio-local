# Default deny: only reviewed source, synthetic examples, and documentation belong in Git.
# Add new paths deliberately; never force-add financial data or credentials.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/SECURITY.md
!/pyproject.toml
!/start.ps1
!/claude-desktop.example.json

!/portfolio/
/portfolio/*
!/portfolio/*.py

!/tests/
/tests/*
!/tests/*.py

!/scripts/
/scripts/*
!/scripts/check_repository.py

!/.githooks/
/.githooks/*
!/.githooks/pre-commit
!/.githooks/pre-push

!/web/
/web/*
!/web/package.json
!/web/package-lock.json
!/web/index.html
!/web/tsconfig.json
!/web/vite.config.ts
!/web/src/
/web/src/*
!/web/src/*.ts
!/web/src/*.tsx
!/web/src/*.css
!/web/public/
/web/public/*
!/web/public/favicon.svg

!/docs/
/docs/*
!/docs/USAGE.md
!/docs/demo-preview.jpg

!/examples/
/examples/*
!/examples/transactions.csv
!/examples/holdings-only.csv
!/examples/manual-transaction.json

# Defense in depth for sensitive files, dependencies, and generated output.
**/data/
**/backups/
**/imports/
**/exports/
**/statements/
**/node_modules/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.uv-cache/
**/.npm-cache/
**/*.egg-info/
**/dist/
**/test-results/
**/playwright-report/
**/.env
**/.env.*
**/.npmrc
**/.pypirc
**/credentials*
**/secrets*
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.sqlite3-*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.pdf
**/*.xlsx
**/*.xls
**/*.log
**/*.bak
**/*.zip
**/*.tsbuildinfo
**/*PRD*.md
